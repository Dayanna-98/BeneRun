# Backend production environment variables template
# Copy to .env.production in server environment and fill with real values.

APP_NAME="BeneRun"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://votre-domaine.tld
APP_KEY=base64:CHANGE_ME_WITH_PHP_ARTISAN_KEY_GENERATE

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=benerun
DB_USERNAME=benerun_user
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.votre-domaine.tld
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=benerun-prod
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=votre-domaine.tld
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

CORS_ALLOWED_ORIGINS=https://votre-frontend.tld,https://votre-domaine.tld
CORS_ALLOWED_ORIGIN_PATTERNS=

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre.adresse@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application-gmail
MAIL_FROM_ADDRESS="votre.adresse@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://votre-frontend.tld
FRONTEND_RESET_PASSWORD_URL_TEMPLATE=
FRONTEND_EMAIL_VERIFICATION_URL_TEMPLATE=