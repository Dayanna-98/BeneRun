APP_NAME="Béné'Run"
APP_ENV=local
APP_KEY=base64:CHANGE_ME_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=benerun
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=benerun-local
REVERB_APP_KEY=benerun-local-key
REVERB_APP_SECRET=benerun-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail - Configuration Gmail (SMTP)
# Important: MAIL_PASSWORD doit contenir un mot de passe d'application Google (pas le mot de passe du compte).
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre.adresse@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application-gmail
MAIL_FROM_ADDRESS="votre.adresse@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL=http://localhost:5173

# Optionnel: personnaliser le lien de reset avec des placeholders
# Exemple: https://app.benerun.fr/reset-password?token={token}&email={email}
FRONTEND_RESET_PASSWORD_URL_TEMPLATE=

# Optionnel: personnaliser la redirection après vérification email ({status}, {message}, {email})
# Exemple: https://app.benerun.fr/email-verification?status={status}&message={message}&email={email}
FRONTEND_EMAIL_VERIFICATION_URL_TEMPLATE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
